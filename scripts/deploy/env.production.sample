# /srv/mojasame/.env  —  chmod 600, مالک mojasame
# هیچ‌کدام از این مقادیر نباید کامیت شوند.

# ——— سایت ———
NEXT_PUBLIC_SITE_URL="https://mojasamesaidi.ir"
NEXT_PUBLIC_SITE_NAME="فروشگاه مجسمه‌سازی سعیدی"
LOG_LEVEL="info"

# ——— دیتابیس ———
# فعلاً همان Postgres مدیریت‌شده‌ی موجود. اگر بعداً به Postgres همین سرور
# منتقل شد:  postgresql://mojasame:PASS@127.0.0.1:5432/mojasame?schema=public
DATABASE_URL=""

# ——— نشست ———
# با  openssl rand -base64 32  بسازید. با مقدار لوکال یکی نباشد.
AUTH_SECRET=""

# ——— زرین‌پال ———
ZARINPAL_MERCHANT_ID=""
# sandbox زرین‌پال بازنشسته شده؛ در production نباید true باشد.
ZARINPAL_SANDBOX="false"
PAYMENT_CALLBACK_URL="https://mojasamesaidi.ir/api/payments/zarinpal/callback"
# فقط اگر ساب‌دامین اختصاصی درگاه را واقعاً نزد زرین‌پال ثبت و CNAME کرده‌اید.
# در غیر این صورت خالی بماند، وگرنه صفحه‌ی پرداخت ۴۰۴ می‌دهد.
# ZARINPAL_GATEWAY_DOMAIN=""

# ——— آپلود تصاویر ———
# local روی VPS پایدار است: /var/lib/mojasame/uploads که به public/uploads
# لینک شده. برای Cloudinary مقدار را cloudinary کنید و کلیدها را پر کنید.
UPLOAD_STORAGE_DRIVER="local"
NEXT_PUBLIC_UPLOAD_STORAGE_DRIVER="local"
UPLOAD_MAX_IMAGE_MB="5"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# ——— ایمیل بازیابی رمز ———
# بدون این، لینک بازیابی فقط در لاگ سرور نوشته می‌شود و ایمیلی ارسال نمی‌شود.
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@mojasamesaidi.ir"
